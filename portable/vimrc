function! s:IndentGuides() abort
  if &filetype ==# 'hxtree'
    return
  endif
  let l:sw = shiftwidth()
  if has('patch-8.2.5066')
    let &l:listchars = 'tab:│ ,nbsp:⍽,leadmultispace:│' . repeat(' ', l:sw > 1 ? l:sw - 1 : 3)
  else
    let &listchars = 'tab:│ ,nbsp:⍽'
  endif
  setlocal list
endfunction

function! s:GitBranch() abort
  if !executable('git')
    return
  endif
  let l:dir = expand('%:p:h')
  if empty(l:dir) || !isdirectory(l:dir)
    let l:dir = getcwd()
  endif
  let b:hx_branch = substitute(system('git -C ' . shellescape(l:dir) . ' rev-parse --abbrev-ref HEAD 2>/dev/null'), '\n\|^HEAD$', '', 'g')
  if v:shell_error
    let b:hx_branch = ''
  endif
endfunction

