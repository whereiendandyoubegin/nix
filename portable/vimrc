function! HxFenc() abort
  return (empty(&fileencoding) || &fileencoding ==# 'utf-8') ? '' : '  ' . &fileencoding
endfunction

function! HxDiagCount() abort
  let l:n = len(get(b:, 'hx_diags', {}))
  return l:n ? '● ' . l:n . '  ' : ''
endfunction

function! HxStatusline(active) abort
  let l:s = '%#StatusLineNC#     '
  if a:active
    let l:m = mode()
    if l:m =~# "^[vV\<C-v>]" && g:hx_ext
      let [l:label, l:hl] = ['SEL', 'HxSel']
    elseif l:m =~# '^[iR]'
      let [l:label, l:hl] = ['INS', 'HxIns']
    else
      let [l:label, l:hl] = ['NOR', 'HxNor']
    endif
    let l:s = '%#' . l:hl . '# ' . l:label . ' %#StatusLine# '
  endif
  let l:s .= ' %{get(b:, "hx_branch", "")}'
  let l:s .= '%=%f%{&modified ? "[+]" : ""}%{&readonly ? " [readonly]" : ""}%='
  let l:s .= (a:active ? '%#HxDiag#' : '') . '%{HxDiagCount()}' . (a:active ? '%#StatusLine#' : '')
  let l:s .= '1 sel  %l:%c  %L  %p%%%{HxFenc()} '
  return l:s
endfunction

function! HxTabline() abort
  let l:s = ''
  for l:b in getbufinfo({'buflisted': 1})
    let l:name = empty(l:b.name) ? '[scratch]' : fnamemodify(l:b.name, ':t')
    let l:s .= (l:b.bufnr == bufnr('%') ? '%#TabLineSel#' : '%#TabLine#')
    let l:s .= ' ' . substitute(l:name, '%', '%%', 'g') . (l:b.changed ? '[+]' : '') . ' '
  endfor
  return l:s . '%#TabLineFill#'
endfunction

