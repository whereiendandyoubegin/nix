function! s:Menu(prefix) abort
  let l:count = v:count ? v:count : ''
  let l:items = s:menus[a:prefix]
  let l:cols = max([1, (&columns - 1) / 26])
  let l:rows = []
  let l:i = 0
  while l:i < len(l:items)
    call add(l:rows, join(map(l:items[l:i : l:i + l:cols - 1], {_, it -> printf('%-3s%-23s', it[0], it[1])}), ''))
    let l:i += l:cols
  endwhile
  redraw
  echohl HxNor
  echo ' ' . get({' ': 'space', 'bs': 'backspace'}, a:prefix, a:prefix) . ' '
  echohl None
  for l:r in l:rows
    echo l:r
  endfor
  let l:c = getchar()
  redraw
  let l:k = type(l:c) == type(0) ? nr2char(l:c) : l:c
  if l:k ==# "\<Esc>"
    return
  endif
  let l:p = a:prefix ==# 'bs' ? "\<BS>" : a:prefix
  if !empty(maparg(l:p . l:k, 'n'))
    call feedkeys(l:count . l:p . l:k, 'm')
  elseif a:prefix !=# ' ' && a:prefix !=# 'bs'
    call feedkeys(l:count . l:p . l:k, 'n')
  endif
endfunction

