function! s:IndentGuides() abort
  let l:sw = shiftwidth()
  try
    let &l:listchars = 'tab:│ ,nbsp:⍽,leadmultispace:│' . repeat(' ', l:sw > 1 ? l:sw - 1 : 3)
  catch
    let &l:listchars = 'tab:│ ,nbsp:⍽'
  endtry
  setlocal list
endfunction

function! s:GitBranch() abort
  let l:dir = expand('%:p:h')
  if empty(l:dir) || !isdirectory(l:dir)
    let l:dir = getcwd()
  endif
  let b:hx_branch = trim(system('git -C ' . shellescape(l:dir) . ' branch --show-current 2>/dev/null'))
endfunction

function! HxStatusline() abort
  let l:active = g:statusline_winid == win_getid()
  let l:m = mode()
  if l:m =~# "^[vV\<C-v>sS\<C-s>]"
    let [l:label, l:hl] = ['SEL', 'HxSel']
  elseif l:m =~# '^[iR]'
    let [l:label, l:hl] = ['INS', 'HxIns']
  else
    let [l:label, l:hl] = ['NOR', 'HxNor']
  endif
  let l:buf = winbufnr(g:statusline_winid)
  let l:branch = getbufvar(l:buf, 'hx_branch', '')
  let l:fenc = getbufvar(l:buf, '&fileencoding')
  let l:s = l:active ? '%#' . l:hl . '# ' . l:label . ' %#StatusLine# ' : '%#StatusLineNC#     '
  let l:s .= empty(l:branch) ? '' : ' ' . l:branch
  let l:s .= '%=%f%{&modified ? "[+]" : ""}%{&readonly ? " [readonly]" : ""}%='
  let l:s .= '1 sel  %l:%c  %L  %p%%'
  let l:s .= (empty(l:fenc) || l:fenc ==# 'utf-8') ? '' : '  ' . l:fenc
  return l:s . ' '
endfunction

function! HxTabline() abort
  let l:s = ''
  for l:b in getbufinfo({'buflisted': 1})
    let l:name = empty(l:b.name) ? '[scratch]' : fnamemodify(l:b.name, ':t')
    let l:s .= (l:b.bufnr == bufnr('%') ? '%#TabLineSel#' : '%#TabLine#')
    let l:s .= ' ' . substitute(l:name, '%', '%%', 'g') . (l:b.changed ? '[+]' : '') . ' '
  endfor
  return l:s . '%#TabLineFill#'
endfunction

set statusline=%!HxStatusline()
set tabline=%!HxTabline()

function! s:ToggleComment(first, last) abort
  let l:parts = split(&commentstring, '%s', 1)
  if len(l:parts) != 2
    return
  endif
  let [l:open, l:close] = [trim(l:parts[0]), trim(l:parts[1])]
  let l:eo = escape(l:open, '\')
  let l:ec = escape(l:close, '\')
  let l:lines = getline(a:first, a:last)
  let l:body = filter(copy(l:lines), {_, v -> v =~# '\S'})
  if empty(l:body)
    return
  endif
  let l:commented = empty(filter(copy(l:body), {_, v -> v !~# '\V\^\s\*' . l:eo}))
  if l:commented
    call map(l:lines, {_, v -> substitute(v, '\V\^\(\s\*\)' . l:eo . ' \?', '\1', '')})
    if !empty(l:close)
      call map(l:lines, {_, v -> substitute(v, '\V \?' . l:ec . '\s\*\$', '', '')})
    endif
  else
    let l:indent = min(map(copy(l:body), {_, v -> len(matchstr(v, '^\s*'))}))
    call map(l:lines, {_, v -> v !~# '\S' ? v : strpart(v, 0, l:indent) . l:open . ' ' . strpart(v, l:indent) . (empty(l:close) ? '' : ' ' . l:close)})
  endif
  call setline(a:first, l:lines)
endfunction
command! -range HxComment call s:ToggleComment(<line1>, <line2>)

let g:hx_formatters = {
  \ 'rust': 'rustfmt --edition 2024',
  \ 'go': 'gofmt',
  \ 'c': 'clang-format --assume-filename=%',
  \ 'cpp': 'clang-format --assume-filename=%',
  \ }

function! s:Format() abort
  let l:cmd = get(g:hx_formatters, &filetype, '')
  if empty(l:cmd) || !executable(split(l:cmd)[0])
    return
  endif
  let l:cmd = substitute(l:cmd, '%', escape(shellescape(expand('%:p')), '\&'), 'g')
  let l:src = getline(1, '$')
  let l:out = systemlist(l:cmd, l:src)
  if v:shell_error || l:out ==# l:src
    return
  endif
  let l:view = winsaveview()
  call setline(1, l:out)
  if line('$') > len(l:out)
    silent execute (len(l:out) + 1) . ',$delete _'
  endif
  call winrestview(l:view)
endfunction
command! HxFormat call s:Format()

let g:hx_rg_hidden = 0
let g:hx_rg_ignore = 1
let s:files = []

function! s:FileList() abort
  if empty(s:files)
    if executable('rg')
      let l:cmd = 'rg --files' . (g:hx_rg_hidden ? ' --hidden -g !.git' : '') . (g:hx_rg_ignore ? '' : ' --no-ignore')
      let s:files = systemlist(l:cmd)
    else
      let s:files = filter(glob('**/*', !g:hx_rg_hidden, 1), {_, v -> !isdirectory(v)})
      if g:hx_rg_hidden
        let s:files += filter(glob('**/.*', 0, 1), {_, v -> !isdirectory(v) && v !~# '\.git/'})
      endif
    endif
  endif
  return s:files
endfunction

function! HxFileComplete(lead, line, pos) abort
  let l:files = s:FileList()
  return empty(a:lead) ? l:files[: 500] : matchfuzzy(l:files, a:lead)[: 500]
endfunction
