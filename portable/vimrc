function! s:Diagnose() abort
  let l:out = []
  let l:py = s:Python()
  let l:file = shellescape(expand('%:p'))
  if &filetype ==# 'python' && !empty(l:py)
    let l:out = systemlist(l:py . ' -c ' . shellescape(s:py_check) . ' ' . l:file)
  elseif &filetype ==# 'yaml' && !empty(l:py)
    let l:out = systemlist(l:py . ' -c ' . shellescape(s:yaml_check) . ' ' . l:file)
  elseif &filetype ==# 'terraform'
    let l:out = get(b:, 'hx_fmt_diags', [])
  elseif !exists('b:hx_diags')
    return
  endif
  let l:buf = bufnr('%')
  for l:id in get(b:, 'hx_sign_ids', [])
    execute 'sign unplace ' . l:id . ' buffer=' . l:buf
  endfor
  let b:hx_diags = {}
  let b:hx_sign_ids = []
  let l:items = []
  for l:line in l:out
    let l:m = matchlist(l:line, '^\(\d\+\):\(\d\+\):\(.*\)$')
    if empty(l:m) || has_key(b:hx_diags, l:m[1])
      continue
    endif
    let b:hx_diags[l:m[1]] = l:m[3]
    call add(l:items, {'bufnr': l:buf, 'lnum': str2nr(l:m[1]), 'col': str2nr(l:m[2]), 'text': l:m[3], 'type': 'E'})
    call add(b:hx_sign_ids, 7000 + str2nr(l:m[1]))
    execute 'sign place ' . (7000 + str2nr(l:m[1])) . ' line=' . l:m[1] . ' name=HxDiag buffer=' . l:buf
  endfor
  call setloclist(0, l:items)
endfunction

function! s:EchoDiag() abort
  let l:msg = get(get(b:, 'hx_diags', {}), line('.'), '')
  if !empty(l:msg)
    echohl WarningMsg | echo strpart(l:msg, 0, &columns - 12) | echohl None
    let s:echoed = 1
  elseif get(s:, 'echoed', 0)
    echo ''
    let s:echoed = 0
  endif
endfunction

function! s:Lnav(cmd, wrap) abort
  try
    execute a:cmd
  catch /E553\|E42\|E776/
    try
      execute a:wrap
    catch
    endtry
  endtry
endfunction

let g:hx_formatters = {
  \ 'python': ['ruff format -', 'black -q -'],
  \ 'terraform': ['terraform fmt -no-color -'],
  \ 'go': ['gofmt'],
  \ 'rust': ['rustfmt --edition 2024'],
  \ }

function! s:Format() abort
  let l:cmd = ''
  for l:c in get(g:hx_formatters, &filetype, [])
    if executable(split(l:c)[0])
      let l:cmd = l:c
      break
    endif
  endfor
  if empty(l:cmd)
    return
  endif
  let l:err = tempname()
  let l:src = getline(1, '$')
  let l:out = systemlist('(' . l:cmd . ') 2>' . shellescape(l:err), l:src)
  let b:hx_fmt_diags = []
  if v:shell_error
    let l:msg = ''
    for l:line in filereadable(l:err) ? readfile(l:err) : []
      let l:e = matchstr(l:line, 'Error: \zs.*')
      if !empty(l:e)
        let l:msg = l:e
      endif
      let l:n = matchstr(l:line, ' line \zs\d\+')
      if !empty(l:n)
        call add(b:hx_fmt_diags, l:n . ':1:' . l:msg)
      endif
    endfor
    call delete(l:err)
    return
  endif
  call delete(l:err)
  if l:out ==# l:src
    return
  endif
  let l:view = winsaveview()
  call setline(1, l:out)
  if line('$') > len(l:out)
    silent execute (len(l:out) + 1) . ',$delete _'
  endif
  call winrestview(l:view)
endfunction
command! HxFormat call s:Format()

let g:hx_hidden = 0
let g:hx_ignore = 1
let s:files = []

function! s:FileList() abort
  if !empty(s:files)
    return s:files
  endif
  if executable('rg')
    let s:files = systemlist('rg --files' . (g:hx_hidden ? ' --hidden -g !.git' : '') . (g:hx_ignore ? '' : ' --no-ignore'))
  elseif g:hx_ignore && executable('git') && !empty(system('git rev-parse --show-toplevel 2>/dev/null'))
    let s:files = systemlist('git ls-files -co --exclude-standard')
    if !g:hx_hidden
      call filter(s:files, {_, v -> v !~# '\(^\|/\)\.'})
    endif
  else
    let s:files = filter(glob('**/*', !g:hx_ignore, 1), {_, v -> !isdirectory(v)})
    if g:hx_hidden
      let s:files += filter(glob('**/.*', 0, 1), {_, v -> !isdirectory(v) && v !~# '\.git/'})
    endif
  endif
  return s:files
endfunction

function! s:Fuzzy(list, lead) abort
  if exists('*matchfuzzy')
    return matchfuzzy(a:list, a:lead)
  endif
  let l:pat = '\V' . join(map(split(a:lead, '\zs'), {_, c -> escape(c, '\')}), '\.\{-}')
  return filter(copy(a:list), {_, v -> v =~? l:pat})
endfunction

function! HxFileComplete(lead, line, pos) abort
  let l:files = s:FileList()
  return (empty(a:lead) ? l:files : s:Fuzzy(l:files, a:lead))[: 500]
endfunction
