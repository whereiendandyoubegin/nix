function! s:HclSyntax() abort
  syntax clear
  syntax keyword hclBlock resource data variable output locals module provider terraform moved import check removed backend required_providers lifecycle dynamic content
  syntax keyword hclBool true false null
  syntax keyword hclKeyword for in if else endif endfor
  syntax keyword hclType string number bool list map set object tuple any
  syntax match hclNumber '\<\d\+\(\.\d\+\)\?\>'
  syntax match hclFunc '\<[a-z_][a-z0-9_]*\ze('
  syntax match hclAttr '^\s*\zs[A-Za-z_][A-Za-z0-9_-]*\ze\s*='
  syntax region hclInterp matchgroup=hclInterpDelim start='[$%]{' end='}' contained contains=hclNumber,hclBool,hclFunc,hclKeyword,hclString
  syntax region hclString start=+"+ skip=+\\"+ end=+"+ contains=hclInterp
  syntax region hclHeredoc start='<<-\?\z([A-Z_]\+\)' end='^\s*\z1$' contains=hclInterp
  syntax match hclComment '\(#\|//\).*$'
  syntax region hclComment start='/\*' end='\*/'
  hi def link hclBlock Statement
  hi def link hclKeyword Statement
  hi def link hclBool Constant
  hi def link hclNumber Constant
  hi def link hclType Type
  hi def link hclFunc Function
  hi def link hclAttr Identifier
  hi def link hclString String
  hi def link hclHeredoc String
  hi def link hclInterpDelim Special
  hi def link hclComment Comment
  let b:current_syntax = 'terraform'
endfunction

