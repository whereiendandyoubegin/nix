function! s:TogglePicker(opt) abort
  let g:{a:opt} = !g:{a:opt}
  let s:files = []
  if a:opt ==# 'hx_rg_hidden'
    let g:netrw_hide = !g:hx_rg_hidden
  endif
  echo a:opt . ' = ' . g:{a:opt}
endfunction

let s:pairs = {'(': ')', '[': ']', '{': '}', '"': '"', "'": "'", '`': '`'}

function! s:PairOpen(o, c) abort
  let l:line = getline('.')
  let l:next = l:line[col('.') - 1]
  let l:prev = col('.') > 1 ? l:line[col('.') - 2] : ''
  if a:o ==# a:c
    if l:next ==# a:c
      return "\<C-g>U\<Right>"
    endif
    if l:prev =~# '\w'
      return a:o
    endif
  endif
  if l:next =~# '\w'
    return a:o
  endif
  return a:o . a:c . "\<C-g>U\<Left>"
endfunction

function! s:PairClose(c) abort
  return getline('.')[col('.') - 1] ==# a:c ? "\<C-g>U\<Right>" : a:c
endfunction

function! s:PairBS() abort
  let l:line = getline('.')
  let l:i = col('.') - 1
  if l:i > 0 && has_key(s:pairs, l:line[l:i - 1]) && s:pairs[l:line[l:i - 1]] ==# l:line[l:i]
    return "\<BS>\<Del>"
  endif
  return "\<BS>"
endfunction

for [s:o, s:c] in items(s:pairs)
  execute 'inoremap <expr> ' . s:o . ' <SID>PairOpen(' . string(s:o) . ', ' . string(s:c) . ')'
  if s:o !=# s:c
    execute 'inoremap <expr> ' . s:c . ' <SID>PairClose(' . string(s:c) . ')'
  endif
endfor
