  \ 'L = yaml.SafeLoader',
  \ 'L.add_multi_constructor("", lambda l, s, n: None)',
  \ 'try:',
  \ '    list(yaml.load_all(open(sys.argv[1]), Loader=L))',
  \ 'except yaml.MarkedYAMLError as e:',
