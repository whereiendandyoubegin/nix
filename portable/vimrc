endfunction

let s:py_check = join([
  \ 'import sys',
  \ 'p = sys.argv[1]',
  \ 's = open(p).read()',
  \ 'try:',
  \ '    compile(s, p, "exec")',
  \ 'except SyntaxError as e:',
  \ '    print("%d:%d:%s" % (e.lineno or 1, e.offset or 1, e.msg))',
  \ '    sys.exit()',
  \ 'try:',
  \ '    from pyflakes import api',
  \ 'except ImportError:',
  \ '    sys.exit()',
  \ 'class R(object):',
  \ '    def unexpectedError(self, *a): pass',
  \ '    def syntaxError(self, *a): pass',
  \ '    def flake(self, m): print("%d:%d:%s" % (m.lineno, m.col + 1, m.message % m.message_args))',
  \ 'api.check(s, p, R())',
