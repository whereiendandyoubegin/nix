function! s:TogglePicker(opt) abort
  let g:{a:opt} = !g:{a:opt}
  let s:files = []
  for l:w in range(1, winnr('$'))
    if getbufvar(winbufnr(l:w), '&filetype') ==# 'hxtree'
      let l:cur = winnr()
      execute l:w . 'wincmd w'
      call s:TreeRender()
      execute l:cur . 'wincmd w'
    endif
  endfor
  echo a:opt . ' = ' . g:{a:opt}
endfunction

function! s:Tmux(args) abort
  return systemlist('tmux ' . a:args)
endfunction

function! s:ToTmux() abort
  if !empty($TMUX)
    call system('tmux load-buffer -', substitute(@", '\n\+$', '', ''))
  endif
  if !exists('s:osc52')
    let s:osc52 = executable('base64') && filewritable('/dev/tty') && (empty($TMUX) || str2float(matchstr(system('tmux -V'), '\d\+\.\d\+')) >= 3.0)
  endif
  if s:osc52
    let l:b64 = substitute(system('base64 | tr -d "\n"', @"), '\n', '', 'g')
    call writefile(["\e]52;c;" . l:b64 . "\x07"], '/dev/tty', 'b')
  endif
endfunction

function! s:FromTmux() abort
  if !empty($TMUX)
    let l:text = system('tmux save-buffer -')
    if !v:shell_error
      call setreg('"', l:text, l:text =~# '\n$' ? 'V' : 'v')
    endif
  endif
endfunction

function! s:TreeList(dir) abort
  let l:items = glob(fnameescape(a:dir) . '/*', 1, 1)
  if g:hx_hidden
    let l:items += filter(glob(fnameescape(a:dir) . '/.[^.]*', 1, 1) + glob(fnameescape(a:dir) . '/..?*', 1, 1), {_, v -> v !~# '/\.git$'})
  endif
  let l:dirs = sort(filter(copy(l:items), {_, v -> isdirectory(v)}))
  let l:files = sort(filter(copy(l:items), {_, v -> !isdirectory(v)}))
  return l:dirs + l:files
endfunction

function! s:TreeWalk(dir, depth, lines) abort
  for l:p in s:TreeList(a:dir)
    let l:isdir = isdirectory(l:p)
    let l:open = l:isdir && get(b:hx_open, l:p, 0)
    call add(a:lines, repeat('  ', a:depth) . (l:isdir ? (l:open ? '▾ ' : '▸ ') : '  ') . fnamemodify(l:p, ':t') . (l:isdir ? '/' : ''))
    call add(b:hx_items, l:p)
    if l:open
      call s:TreeWalk(l:p, a:depth + 1, a:lines)
    endif
  endfor
endfunction

function! s:TreeRender() abort
  let l:lnum = line('.')
  let b:hx_items = [fnamemodify(b:hx_root, ':h')]
  let l:lines = [fnamemodify(b:hx_root, ':~') . (b:hx_root ==# '/' ? '' : '/')]
  call s:TreeWalk(b:hx_root, 0, l:lines)
  setlocal modifiable
  silent %delete _
  call setline(1, l:lines)
  setlocal nomodifiable nomodified
  call cursor(min([l:lnum, line('$')]), 1)
endfunction

function! s:TreeFind(path) abort
  let l:i = index(b:hx_items, a:path)
  if l:i >= 0
    call cursor(l:i + 1, 1)
  endif
endfunction

function! s:TreeRoot(dir) abort
  let l:old = b:hx_root
  let b:hx_root = a:dir
  call s:TreeRender()
  call s:TreeFind(l:old)
endfunction

function! s:TreeEnter() abort
  let l:p = get(b:hx_items, line('.') - 1, '')
  if line('.') == 1
    call s:TreeRoot(l:p)
  elseif isdirectory(l:p)
    let b:hx_open[l:p] = !get(b:hx_open, l:p, 0)
    call s:TreeRender()
  elseif !empty(l:p)
    call s:TreeOpen(l:p)
  endif
endfunction

function! s:TreeCollapse() abort
  let l:p = get(b:hx_items, line('.') - 1, '')
  if line('.') > 1 && isdirectory(l:p) && get(b:hx_open, l:p, 0)
    let b:hx_open[l:p] = 0
    call s:TreeRender()
  elseif line('.') > 1
    let l:parent = fnamemodify(l:p, ':h')
    if l:parent ==# b:hx_root
      call cursor(1, 1)
    else
      call s:TreeFind(l:parent)
    endif
  endif
endfunction

function! s:TreeCd() abort
  let l:p = get(b:hx_items, line('.') - 1, '')
  if isdirectory(l:p)
    call s:TreeRoot(l:p)
    execute 'lcd ' . fnameescape(l:p)
  endif
endfunction

function! s:TmuxOpen(path) abort
  let l:me = $TMUX_PANE
  let l:main = get(s:Tmux('show -wqv -t ' . shellescape(l:me) . ' @main'), 0, '')
  let l:best = []
  let l:area = -1
  for l:line in s:Tmux('list-panes -t ' . shellescape(l:me) . ' -F ' . shellescape('#{pane_id} #{pane_width} #{pane_height} #{pane_current_command}'))
    let l:f = split(l:line)
    if len(l:f) < 4 || l:f[0] ==# l:me
      continue
    endif
    if l:f[0] ==# l:main
      let l:best = l:f
      break
    endif
    if l:f[1] * l:f[2] > l:area
      let [l:best, l:area] = [l:f, l:f[1] * l:f[2]]
    endif
  endfor
  let l:vim = shellescape(v:progpath) . ' ' . shellescape(a:path)
  if empty(l:best)
    call s:Tmux('split-window -h -t ' . shellescape(l:me) . ' ' . shellescape(l:vim))
    return
  endif
  let l:t = ' -t ' . shellescape(l:best[0])
  if l:best[3] ==# 'vim'
    call s:Tmux('send-keys' . l:t . ' C-\\ C-n \; send-keys' . l:t . ' -l ' . shellescape(':edit ' . fnameescape(a:path)) . ' \; send-keys' . l:t . ' Enter')
  elseif l:best[3] =~# '^-\?\(ba\|z\|k\|da\|fi\|tc\|c\)\?sh$'
    call s:Tmux('send-keys' . l:t . ' C-u \; send-keys' . l:t . ' -l ' . shellescape(l:vim) . ' \; send-keys' . l:t . ' Enter')
  else
    call s:Tmux('new-window -c ' . shellescape(fnamemodify(a:path, ':h')) . ' ' . shellescape(l:vim))
    return
  endif
  call s:Tmux('select-pane' . l:t)
endfunction

function! s:TreeOpen(path) abort
  if get(g:, 'hx_sidebar', 0) && !empty($TMUX_PANE)
    call s:TmuxOpen(a:path)
    return
  endif
  let l:tree = winnr()
  wincmd p
  if winnr() == l:tree
    rightbelow vnew
    let l:new = winnr()
    execute l:tree . 'wincmd w'
    execute 'vertical resize ' . max([20, &columns * 15 / 100])
    execute l:new . 'wincmd w'
  endif
  execute 'edit ' . fnameescape(a:path)
endfunction

function! s:Tree(dir) abort
  let l:root = fnamemodify(empty(a:dir) ? getcwd() : a:dir, ':p')
  let l:root = l:root ==# '/' ? l:root : substitute(l:root, '/$', '', '')
  let l:fresh = argc() == 0 && bufname('%') ==# '' && line('$') == 1 && getline(1) ==# '' && winnr('$') == 1
  if l:fresh && !empty($TMUX)
    let g:hx_sidebar = 1
    set showtabline=0
  else
    for l:w in range(1, winnr('$'))
      if getbufvar(winbufnr(l:w), '&filetype') ==# 'hxtree'
        execute l:w . 'wincmd c'
        return
      endif
    endfor
    let l:file = expand('%:p')
    topleft vertical new
    execute 'vertical resize ' . max([20, &columns * 15 / 100])
    setlocal winfixwidth
  endif
  setlocal buftype=nofile bufhidden=wipe noswapfile nobuflisted nowrap nonumber nolist nocursorcolumn
  setlocal filetype=hxtree
  setlocal statusline=%#HxNor#\ EXPLORER\ %#StatusLine#\ %{fnamemodify(get(b:,'hx_root',''),':t')}
  let b:hx_root = l:root
  let b:hx_open = {}
  syntax match HxTreeRoot '\%1l.*'
  syntax match HxTreeDir '[▾▸] .*/$'
  hi link HxTreeRoot Title
  hi link HxTreeDir Directory
  nnoremap <buffer> <silent> <CR> :call <SID>TreeEnter()<CR>
  nnoremap <buffer> <silent> l :call <SID>TreeEnter()<CR>
  nnoremap <buffer> <silent> o :call <SID>TreeEnter()<CR>
  nnoremap <buffer> <silent> <2-LeftMouse> :call <SID>TreeEnter()<CR>
  nnoremap <buffer> <silent> h :call <SID>TreeCollapse()<CR>
  nnoremap <buffer> <silent> - :call <SID>TreeRoot(fnamemodify(b:hx_root, ':h'))<CR>
  nnoremap <buffer> <silent> <BS> :call <SID>TreeRoot(fnamemodify(b:hx_root, ':h'))<CR>
  nnoremap <buffer> <silent> C :call <SID>TreeCd()<CR>
  nnoremap <buffer> <silent> . :call <SID>TogglePicker('hx_hidden')<CR>
  nnoremap <buffer> <silent> R :call <SID>TreeRender()<CR>
  nnoremap <buffer> <silent> q :quit<CR>
  call s:TreeRender()
  if exists('l:file') && !empty(l:file)
    let l:dir = fnamemodify(l:file, ':h')
    while len(l:dir) > len(l:root) && stridx(l:dir, l:root) == 0
      let b:hx_open[l:dir] = 1
      let l:dir = fnamemodify(l:dir, ':h')
    endwhile
    call s:TreeRender()
    call s:TreeFind(l:file)
  endif
endfunction
command! -nargs=? -complete=dir HxTree call s:Tree(<q-args>)

function! s:Sel(motion, visual) abort
  let l:n = v:count1
  let g:hx_ext = 0
  if a:visual
    let l:at = getpos('.')
    if a:motion =~? 'w'
      execute 'normal! ' . a:motion
    elseif a:motion =~? 'e'
      normal! l
      if getpos('.') == l:at && line('.') < line('$')
        normal! j0
      endif
    elseif getline('.')[col('.') - 1] =~# '\S' && col('.') > 1 && getline('.')[col('.') - 2] =~# '\s'
      normal! h
    endif
  endif
  let l:anchor = getpos('.')
  execute 'normal! ' . l:n . a:motion
  if a:motion =~? 'w'
    let l:head = getpos('.')
    if l:head[1] > l:anchor[1]
      let l:prev = l:head[1] - 1
      call cursor(l:prev, max([1, col([l:prev, '$']) - 1]))
    elseif l:head != l:anchor
      normal! h
    else
      normal! $
    endif
  endif
  let l:head = getpos('.')
  call setpos('.', l:anchor)
  normal! v
  call setpos('.', l:head)
endfunction

let s:pairs = {'(': ')', '[': ']', '{': '}', '"': '"', "'": "'", '`': '`'}

function! s:PairOpen(o, c) abort
  let l:line = getline('.')
  let l:next = l:line[col('.') - 1]
  let l:prev = col('.') > 1 ? l:line[col('.') - 2] : ''
  if a:o ==# a:c
    if l:next ==# a:c
      return "\<C-g>U\<Right>"
    endif
    if l:prev =~# '\w'
      return a:o
    endif
  endif
  if l:next =~# '\w'
    return a:o
  endif
  return a:o . a:c . "\<C-g>U\<Left>"
endfunction

function! s:PairClose(c) abort
  return getline('.')[col('.') - 1] ==# a:c ? "\<C-g>U\<Right>" : a:c
endfunction

function! s:PairBS() abort
  let l:line = getline('.')
  let l:i = col('.') - 1
  if l:i > 0 && has_key(s:pairs, l:line[l:i - 1]) && s:pairs[l:line[l:i - 1]] ==# l:line[l:i]
    return "\<BS>\<Del>"
  endif
  return "\<BS>"
endfunction

