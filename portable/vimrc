function! s:ToggleComment(first, last) abort
  let l:parts = split(&commentstring, '%s', 1)
  if len(l:parts) != 2
    return
  endif
  let l:open = substitute(l:parts[0], '^\s\+\|\s\+$', '', 'g')
  let l:close = substitute(l:parts[1], '^\s\+\|\s\+$', '', 'g')
  let l:eo = escape(l:open, '\')
  let l:ec = escape(l:close, '\')
  let l:lines = getline(a:first, a:last)
  let l:body = filter(copy(l:lines), {_, v -> v =~# '\S'})
  if empty(l:body)
    return
  endif
  let l:commented = empty(filter(copy(l:body), {_, v -> v !~# '\V\^\s\*' . l:eo}))
  if l:commented
    call map(l:lines, {_, v -> substitute(v, '\V\^\(\s\*\)' . l:eo . ' \?', '\1', '')})
    if !empty(l:close)
      call map(l:lines, {_, v -> substitute(v, '\V \?' . l:ec . '\s\*\$', '', '')})
    endif
  else
    let l:indent = min(map(copy(l:body), {_, v -> len(matchstr(v, '^\s*'))}))
    call map(l:lines, {_, v -> v !~# '\S' ? v : strpart(v, 0, l:indent) . l:open . ' ' . strpart(v, l:indent) . (empty(l:close) ? '' : ' ' . l:close)})
  endif
  call setline(a:first, l:lines)
endfunction
command! -range HxComment call s:ToggleComment(<line1>, <line2>)

function! s:Python() abort
  for l:p in ['python3', '/usr/libexec/platform-python', 'python']
